{% block body %}
  <style>
     body {
        
            min-height: 222vh;
            position: relative;
         }
    .modal-lg {
    max-width: 100%;
}

.text-right {
    direction: rtl;
}

.row {
    margin-top: 20px;
}

h1 {
    font-size: 36px;
    color: #333;
    margin-bottom: 20px;
}

p {
    font-size: 18px;
    color: #555;
}
.main-header {
    background-color: #f0f0f0; /* Light gray background color */
    padding: 20px;
    border-bottom: 2px solid #ccc; /* Gray border at the bottom */
}

.content-row {
    background-color: #e9ecef; /* Light gray background color */
    padding: 20px;
    border-bottom: 1px solid #ccc; /* Light gray border at the bottom */
}
.modal-body {
  text-align: center;
}

.modal-video {
  max-width: 100%;
  height: auto;
}
     .video-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.7);
      z-index: 9999;
    }

    /* Style for the video container */
    .video-container {
      position: relative;
      max-width: 800px;
      margin: 50px auto;
    }

    /* Style for the video element */
    .overlay-video {
      width: 100%;
      height: auto;
    }
    </style>
 <div class="container mt-4"> <!-- Adjust top margin -->
          <!-- Bootstrap Breadcrumb Row -->
        <div class="row">
            <div class="col-md-5 offset-md-8">
                <nav aria-label="breadcrumb" style=" direction: rtl;  padding: 10px;">
                    <ol class="breadcrumb" style="margin: 20; padding: 20; background-color: transparent;"> <!-- Remove background color -->
                        <li class="breadcrumb-item"><a href="/"><i class="fas fa-home" style="color: #007bff;"></i></a></li>
                        <li class="breadcrumb-item active" aria-current="page" style="color: #6c757d;"> حديقة اثار حي ماقون قرطاج </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
<div class="container">

</div>
     <div class="container-fluid">
        <div class="row text-right main-header">
            <!-- Main Content -->
              <h1> فيديوهات حديقة اثار حي ماقون قرطاج </h1>
        </div>
        <div class="row text-right content-row">
              <p> <Strong> ماغون القرطاجي </strong> (القرن 3 ق م - القرن 2 ق م)، قائد عسكري وعالم زراعي، اهتم بالفلاحة في وقت السلم في قرطاج و دعاه أبا   الفلاحة   وماغون هو أبرز علماء الفلاحة القدامى وكتب موسوعة ب28 مجلدا على الفلاحة  وكانت الموسوعة مرجعا أساسيا في العصور القديمة لعدة قرون إذ أحدث ماغون منظومة لهيكلة الفلاحة وتنميتها ومازالت طرقه تُستعمل حتى يومنا هذا.
            </div>



 <div class="row">
    <div class="col-md-4">
      <a href="{{ asset('images/milestone/milestone1.mp4') }}" class="video-link" data-video="video1.mp4">
        <img src="{{ asset('images/milestone/video1.jpg') }}" alt="Video 1" class="img-thumbnail">
      </a>
    </div>
    <div class="col-md-4">
      <a href="{{ asset('images/milestone/milestone2.mp4') }}" class="video-link" data-video="video2.mp4">
        <img src="{{ asset('images/milestone/video2.jpg') }}" alt="Video 2" class="img-thumbnail">
      </a>
    </div>
    
  </div>
</div>

<div class="video-overlay">
  <div class="video-container">
    <video controls autoplay class="overlay-video">
      Your browser does not support the video tag.
    </video>
  </div>
</div>


<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function() {
  $('.video-link').click(function(e) {
    e.preventDefault();
    var videoSrc = $(this).attr('href'); // Get the href attribute of the clicked link
    $('.overlay-video').attr('src', videoSrc); // Set the src attribute of the video element
    $('.overlay-video').get(0).volume = 0.1;
    $('.video-overlay').fadeIn();
  });

  $('.video-overlay').click(function(e) {
    if ($(e.target).hasClass('video-overlay')) {
      $('.overlay-video').get(0).pause(); // Pause the video when clicking outside of it
      $(this).fadeOut();
    }
  });
});
</script>

{% endblock %}