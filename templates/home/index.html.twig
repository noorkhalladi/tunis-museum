{% extends 'base.html.twig' %}


{% block body %}

    <!-- Navigation Bar -->
    <style>
     body {
        
            min-height: 300vh;
            position: relative;
        
       
        
    }
    .content {
            padding-bottom: 60px; /* Adjust this value based on your footer's height */
            /* This padding ensures content doesn't get hidden under the fixed footer */
        }
     .custom-navbar {
        background-color: rgba(136, 74, 57, 1); /* RGBA value: 0.5 sets the transparency level */
         position: fixed;
        top: 0;
        width: 100%;
        z-index: 1000; /* Ensure navbar appears on top of other elements */
    }
    .container {
        margin-top: 20px; /* Adjust this value for the distance between navbar and content */
    }
    .custom-navbar .navbar-brand,
    .custom-navbar .navbar-nav .nav-link {
        color: #000; /* Text color for links and brand */
    }
    .sliding-background {
        position: absolute;
        top: 0;
        width: 100%;
        height: 50vh; /* Set the height to half of the viewport height */
       
    }
     .carousel-item img {
        height: 100vh; /* Adjust the height of the carousel as needed */
        object-fit: cover;
    }
    .additional-row {
        background-color: #C38154; /* Background color for the additional row */
        padding: 40px 0; /* Adjust padding as needed */
        text-align: right; /* Center align content */
    }
     .additional-row2 {
        background-color: #F9E0BB; /* Background color for the additional row */
        padding: 50px 0; /* Adjust padding as needed */
        text-align: right; /* Center align content */
    }
     .card {
        transition: transform 0.2s;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .card-title {
        font-size: 1.25rem;
        font-weight: bold;
    }

    .card-text {
        margin-bottom: 20px;
    }

    .card-img-top {
        object-fit: cover;
        height: 200px; /* Adjust image height as needed */
    }

    .stretched-link {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1;
    }
     .position-relative {
        position: relative;
        overflow: ;
    }

    .overlay-text {
        position: absolute;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.7);
        color: white;
        width: 100%;
        padding: 10px;
        text-align: center;
        opacity: 0;
        transition: opacity 0.3s;
    }
    .position-relative img {
        width: 100%;
        height: auto; /* Maintain aspect ratio */
        transition: transform 0.3s ease-in-out;
    }

    .position-relative:hover .overlay-text {
        opacity: 1;
    }
    .custom-caption-2 {
    position: absolute;
    bottom: 20px;
    right: 20px;
    text-align: right;
    background-color: transparent;
    padding: 200px;
    border-radius: 5px;
}
.custom-caption-1 {
    position: absolute;
    top: 50%;
    left: 20%;
    transform: translate(-50%, -50%);
    text-align: center;
    background-color: transparent;
    padding: 10px;
    border-radius: 5px;
}
     .footer {
        
      
       
        background-color: rgba(136, 74, 57, 0.2);
         position: absolute;
            bottom: 0;
            width: 100%;
            height: 200px; /* Adjust this value based on your footer's height */
           
            /* Other styles for your footer */
    }

    .footer h5 {
        font-size: 1.25rem;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .footer p {
        margin-bottom: 5px;
    }
     .quote {
    color: #FFF7F1; /* Change this to the desired color */
  }
</style>


   
<div class="container-fluid">
    <!-- Container to hold the additional row -->
    <div class="row additional-row mb-4 mt-4">
        <div class="col-md-12 ">
            <h2>متاحف , معالم ومواقع اثرية</h2>
            
        </div>
    </div>
</div>
<div class="container mt-4">
