            <div class="position-relative">
                <img src="{{ asset('images/bardo/bardo.jpg') }}" class="img-fluid" alt="Image 1">
                <div class="overlay-text">
                    <h5>متاحف</h5>
                    <p>اكتشفوا المتاحف التي تزخر بها تونس</p>
                    <a href="{{ path('museums') }}">شاهد المزيد</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="position-relative">
                <img src="{{ asset('images/milestone/milestone1.jpg') }}" class="img-fluid" alt="Image 2">
                <div class="overlay-text">
                    <h5>معالم</h5>
                    <p>اكتشفوا المعالم  بتونس</p>
                    <a href="{{ path('milestones') }}">شاهد المزيد</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="position-relative">
                <img src="{{ asset('images/site/site13.jpg') }}" class="img-fluid" alt="Image 3">
                <div class="overlay-text">
                    <h5>مواقع اثرية</h5>
                    <p>تعرفوا على المواقع الأثرية التي تزخر بها تونس</p>
                    <a href="{{ path('sites') }}">شاهد المزيد</a>
                </div>
            </div>
        </div>
    </div>
</div>

 <!-- New Carousel with Bootstrap -->
    <div id="imageCarousel" class="carousel slide" data-ride="carousel">
        <ol class="carousel-indicators">
            <li data-target="#imageCarousel" data-slide-to="0" class="active"></li>
            <li data-target="#imageCarousel" data-slide-to="1"></li>
            <li data-target="#imageCarousel" data-slide-to="2"></li>
            
            <!-- Add more indicators for additional images -->
        </ol>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="{{ asset('images/background/milestone1.jpg') }}" class="d-block w-100" alt="Image 3">
                <div class="carousel-caption custom-caption-1">
                     <h1 class="quote">  الآثار التاريخية هي أصول ثابتة    </h1>
                </div>
            </div>
            <div class="carousel-item">
                <img src="{{ asset('images/background/site1.jpg') }}" class="d-block w-100" alt="Image 4">
                <div class="carousel-caption custom-caption-2 ">
                <h1 class="quote"> المتاحف تثمين الماضي واستشراف للمستقبل    </h1>
               
                
                </div>
            </div>
            <div class="carousel-item">
                <img src="{{ asset('images/background/site2.jpg') }}" class="d-block w-100" alt="Image 4">
                <div class="carousel-caption custom-caption-2 ">
                <h1 class="quote">تراثنا... ثروتنا التي لا تنضب </h1>
                </div>
            </div>
           
            <!-- Add more carousel items for additional images -->
        </div>
       
    </div>
   

<div class="container-fluid">
    <!-- Container to hold the additional row -->
    <div class="row additional-row2 mb-4 mt-4">
        <div class="col-md-12 ">
<h4> الموقع الأثري هو مكان تتواجد فيهه الآثار القديمة التي تبين أن الموقع هو موقع تاريخي أو قبل التاريخ، وممكن أن تتواجد في هذه الأماكن سجلات أثرية تبين الأحداث التي وقعت في ذلك الزمان والمكان وعادةً ما تتواجد في هذه الأماكن مبان ومنشآت أثرية قديمة كمتحف باردو او متحف قرطاج </h4>     
<h5> <a href="{{ path('article') }}"> اكتشفوا المزيد</a></h5>       
        </div>
    </div>
</div>


 <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css">
