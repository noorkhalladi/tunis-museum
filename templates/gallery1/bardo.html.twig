        <img src="" class="img-fluid modal-image" alt="Modal Image">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">غلق</button>
        <button type="button" class="btn btn-primary" id="prevBtn">السابق </button>
